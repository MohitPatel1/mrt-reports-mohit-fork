{
  "name": "@teziapp/smartreport",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "keywords": [
    "smartreport",
    "smart",
    "report",
    "table",
    "material-react-table"
  ],
  "author": "smartreport",
  "license": "CC0-1.0",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev:package": "tsup src/index.tsx --watch",
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "lint": "biome check .",
    "dev": "run-p dev:*",
    "dev:storybook": "pnpm --filter storybook dev",
    "build:storybook": "pnpm --filter storybook build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/x-date-pickers": "^8.0.0",
    "material-react-table": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",    
    "typescript": "~5.7.2"
  },  
  "dependencies": {
    "react-icons": "^5.5.0",
    "tsup": "^8.4.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
